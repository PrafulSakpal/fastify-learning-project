PORT=3000
HOST=0.0.0.0

# Matches docker-compose.yml's postgres service.
DATABASE_URL="postgresql://fastify:fastify@localhost:5433/appointment_api?schema=public"

# Any long random string in development. Rotate for a real deployment —
# see docs/fastify/20-jwt.md.
JWT_SECRET="dev-only-secret-change-me"

# Matches docker-compose.yml's redis service.
REDIS_URL="redis://localhost:6381"
