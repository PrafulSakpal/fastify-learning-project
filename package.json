{
  "name": "fastify-appointment-api",
  "version": "0.1.0",
  "description": "A learning-first Fastify application: a simple Appointment Management API used to teach Fastify concepts end to end.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "worker": "tsx --env-file=.env watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@fastify/websocket": "^11.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.9",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.4",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
